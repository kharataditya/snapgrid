# SnapGrid Environment Variables Template
# Copy this file to backend/.env or run `node database/init_db.js` to auto-configure

PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=snapgrid_db
DB_PORT=3306
DATABASE_URL=mysql://root:your_mysql_password@localhost:3306/snapgrid_db
JWT_SECRET=snapgrid-secret-key-dbms-project-2026-secure
JWT_EXPIRES_IN=7d
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
